# Copy to server/.env.qa and fill only dedicated QA/Test profile UUIDs.
# This file is local-only and is ignored by Git.
QA_TEACHER_USER_ID=
QA_STUDENT_A_USER_ID=
# Optional: leave blank when a second dedicated QA Student is unavailable.
QA_STUDENT_B_USER_ID=

# Optional short-lived Supabase access tokens for real authenticated API tests.
# Never commit this local file. Leave blank to receive MANUAL TEST REQUIRED results.
QA_STUDENT_A_ACCESS_TOKEN=
QA_STUDENT_B_ACCESS_TOKEN=
QA_TEACHER_ACCESS_TOKEN=
QA_API_URL=http://localhost:5000/api
QA_RUN_MUTATIONS=false

# Required acknowledgement before creating isolated QA_* records in a main/production project.
QA_ALLOW_PRODUCTION=false
